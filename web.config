<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".env.old" />
          <add segment=".env.example" />
          <add segment=".venv" />
          <add segment=".git" />
          <add segment="__pycache__" />
          <add segment="private_uploads" />
          <add segment="templates" />
          <add segment="tests" />
        </hiddenSegments>

        <fileExtensions>
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".pyc" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".zip" allowed="false" />
        </fileExtensions>

        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>

    <rewrite>
      <rules>
        <rule name="EmployeeImpactBackend" stopProcessing="true">
          <match url="(.*)" />
          <action
            type="Rewrite"
            url="http://127.0.0.1:8095/{R:1}"
            appendQueryString="true"
          />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>